# Backend Environment Variables Template
PORT=3000
DATABASE_URL="mysql://root:password@127.0.0.1:3306/cpns_training"

# JWT Secrets (Generate long random strings for production)
JWT_SECRET=cpns-training-secret-key-2026
JWT_REFRESH_SECRET=cpns-training-refresh-secret-key-2026

# JWT Expiry settings
JWT_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d

# Environment & CORS
NODE_ENV=development
CORS_ORIGIN="*"
